# Firebase configuration for the shared-link feature.
#
# Copy this file to `.env` and paste in the six values from your Firebase
# project. Phase 4 of the README walks through where to find them:
#   Firebase console -> your project -> Project settings -> Your apps -> Web app
#
# Without these the app still runs — it just offers "I'll assign" mode only.
#
# These keys are NOT secrets. Firebase web config is designed to be public and
# ships inside the JavaScript bundle; what protects your data is the Firestore
# security rules, not hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
